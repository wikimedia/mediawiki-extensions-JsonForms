{
	"$id": "https://wikisphere.org/wiki/JsonSchema:Book",
	"x-layout": "default",
	"required": [
		"title"
	],
	"type": "object",
	"title": "Book",
	"properties": {
		"title": {
			"type": "string",
			"title": "Title",
			"x-format": "text",
			"x-input": "OO.ui.TextInputWidget",
			"x-input-config": {},
			"x-required": true,
			"x-format-type": "custom"
		},
		"authors": {
			"type": "array",
			"title": "Authors",
			"uniqueItems": true,
			"items": {
				"type": "object",
				"properties": {
					"first_name": {
						"type": "string",
						"format": "text",
						"title": "First name"
					},
					"last_name": {
						"type": "string",
						"format": "text",
						"title": "Last name"
					},
					"email": {
						"type": "string",
						"format": "email",
						"title": "Email"
					}
				},
				"required": [
					"first_name",
					"last_name"
				],
				"x-layout": "default",
				"x-required": false
			},
			"x-layout": "default",
			"x-required": false
		},
		"cover": {
			"type": "string",
			"title": "Cover",
			"x-format": "file",
			"x-input": "OO.ui.SelectFileWidget",
			"x-input-config": {
				"accept": [
					"image/svg+xml",
					"image/png",
					"image/gif",
					"image/jpeg",
					"image/pjpeg",
					"image/webp",
					"image/tiff",
					"image/x-tiff",
					"image/bmp",
					"image/x-windows-bmp"
				]
			},
			"x-required": false,
			"x-format-type": "custom"
		},
		"categories": {
			"type": "string",
			"x-required": false,
			"x-format-type": "custom",
			"x-format": "tree",
			"x-input": "FancyTree",
			"x-input-config": {
				"selectMode": 3,
				"source-selector": "wiki article",
				"dataOutput": "concatenated-titles",
				"sourceArticle": "BookCategories"
			},
			"x-border": true,
			"title": "categories",
			"x-title-format": "text"
		}
	}
}
