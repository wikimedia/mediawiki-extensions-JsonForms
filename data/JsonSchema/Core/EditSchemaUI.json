{
	"type": "object",
	"$id": "https://wikisphere.org/wiki/JsonSchema:Core/EditSchemaUI",
	"x-compact": true,
	"required": [],
	"x-default-properties": ["form","categories", "footer"],
	"definitions": {
		"newSchema": {
			"type": "object",
			"title": "{{int:jsonforms-formschema-edit-schema}}",
			"x-title-format": "wikitext",
			"x-value-converter": "newSchema",
			"x-watch": "schema",
			"properties": {
				"schema": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-json-schema}}",
					"x-title-format": "wikitext",
					"default": "",
					"x-format": "text",
					"x-input": "OO.ui.DropdownInputWidget",
					"x-enum-provider": "jsonSchemas"
				},
				"preview": {
					"x-compact": "true",
					"x-css-class": "jsonforms-editschema-preview",
					"x-watch": "schema",
					"links": [
						{
							"rel": "describedBy",
							"href": "JsonSchema:{{schema}}",
							"x-no-validate": true
						}
					]
				}
			}
		}
	},
	"properties": {
		"form": {
			"x-layout": "tabs",
			"x-compact": true,
			"properties": {
				"schema": {
					"type": "object",
					"x-compact": true,
					"additionalProperties": {
						"type": "object",
						"x-compact": true,
						"x-rename": false,
						"properties": {
							"schemaName": {
								"type": "string",
								"x-format": "hidden"
							},
							"editor": {
								"x-no-title": true,
								"x-message": {
									"x-label-template": "Using schema <a href=\"{{replace wgArticlePath '$1' 'JsonSchema:'}}{{schemaName}}\">JsonSchema:{{schemaName}}</a>"
								},
								"x-watch": "schemaName",
								"links": [
									{
										"rel": "describedBy",
										"href": "JsonSchema:{{schemaName}}"
									}
								]
							}
						},
						"required": [ "schemaName" ]
					},
					"maxProperties": 1,
					"x-additional-properties-ui": [
						{
							"label": "{{int:jsonforms-formschema-new-schema}}",
							"x-label-format": "wikitext",
							"schema": "#/definitions/newSchema",
							"popup_size": "large"
						}
					]
				},
				"options": {
					"x-compact": true,
					"properties": {
						"show_infobox": {
							"type": "boolean",
							"title": "{{int:jsonforms-formschema-show-infobox}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-show-infobox-desc}}",
							"x-description-format": "wikitext",
							"default": true
						},
						"infobox_position": {
							"type": "string",
							"title": "{{int:jsonforms-formschema-infobox-position}}",
							"x-title-format": "wikitext",
							"enum": ["right", "left", "top", "bottom"],
							"x-enum-titles": [
								"{{int:jsonforms-formschema-infobox-position-right}}",
								"{{int:jsonforms-formschema-infobox-position-left}}",
								"{{int:jsonforms-formschema-infobox-position-top}}",
								"{{int:jsonforms-formschema-infobox-position-bottom}}"
							],			
							"x-enum-titles-format": "wikitext",
							"default": "right",
							"x-dependency": {
								"path": "show_infobox",
								"op": "==",
								"value": true
							}
						},
						"infobox_template": {
							"type": "string",
							"title": "{{int:jsonforms-formschema-infobox-template}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-infobox-template-desc}}",
							"x-description-format": "wikitext",
							"default": "",
							"x-input": "mw.widgets.TitleInputWidget",
							"x-input-config": {
								"namespace": 10
							},
							"x-dependency": {
								"path": "show_infobox",
								"op": "==",
								"value": true
							}
						},
						"template_print_scalar": {
							"type": "boolean",
							"title": "{{int:jsonforms-formschema-print-scalar}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-print-scalar-desc}}",
							"x-description-format": "wikitext",
							"default": false,
							"x-dependency": {
								"path": "infobox_template",
								"op": "!=",
								"value": ""
							}
						}
					}
				}
			}
		},
		"categories": {
			"x-padding": true,
			"title": "{{int:jsonforms-formschema-categories}}",
			"x-title-format": "wikitext",
			"type": "array",
			"items": {
				"type": "string",
				"x-input": "categorymultiselect"
			}
		},
		"footer": {
			"x-compact": true,
			"x-css-class": "jsonforms-outerform-footer",
			"x-default-properties": ["summary","minor", "buttons"],
			"properties": {
				"summary": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-summary}}",
					"x-title-format": "wikitext"
				},
				"minor": {
					"type": "boolean",
					"x-no-title": true,
					"description": "{{int:jsonforms-formschema-minor-edit}}",
					"x-description-format": "wikitext",
					"x-input": "checkbox",
					"x-control-config": {
						"align": "inline"
					}
				},
				"buttons": {
					"type": "object",
					"x-layout": "horizontal",
					"x-compact": true,
					"properties": {
						"submit": {
							"type": "null",
							"title": "{{int:jsonforms-formschema-save-changes}}",
							"x-title-format": "wikitext",
							"x-format": "button",
							"x-button-action": "submitButton",
							"x-input-config": {
								"flags": ["primary", "progressive"]
							}
						},
						"cancel": {
							"type": "null",
							"title": "{{int:jsonforms-formschema-cancel}}",
							"x-title-format": "wikitext",
							"x-format": "button",
							"x-button-action": "cancelButton",
							"x-input-config": {
								"flags": ["destructive"]
							}
						}
					}
				}
			}
		}
	}
}

