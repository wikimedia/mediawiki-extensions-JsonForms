{
	"type": "object",
	"$id": "https://wikisphere.org/wiki/JsonSchema:Core/NewArticleCombined",
	"x-compact": true,
	"x-css-class": "jsonforms-outerform",
	"required": [],
	"definitions": {
		"editor_wikieditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "wikieditor"
		},
		"editor_visualeditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "visualeditor"
		},
		"editor_jsoneditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "jsoneditor"
		},
		"editor_source": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input-config": {
				"autosize": true,
				"rows": 6
			}
		},
		"editor_suneditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "jsonforms",
			"x-input-config": {
				"schema": {
					"type": "string",
					"x-format": "html",
					"x-input": "SunEditor"
				}
			}			
		},
		"editor_easymde": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "jsonforms",
			"x-input-config": {
				"schema": {
					"type": "string",
					"x-format": "markdown",
					"x-input": "EasyMDE"
				}
			}
		},
		"article": {
			"x-default-properties": ["title","content_model", "editor", "content", "categories"],
			"properties": {
				"title": {
					"type": "string",
					"minLength": 1,
					"x-input": "mw.widgets.TitleInputWidget",
					"title": "{{int:jsonforms-formschema-title}}",
					"x-title-format": "wikitext"
				},
				"content_model": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-content-model}}",
					"x-title-format": "wikitext",
					"default": "wikitext",
					"x-watch": "role",
					"x-enum-provider": "contentModelByRole"
				},
				"editor": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-editor}}",
					"x-title-format": "wikitext",
					"default": "source",
					"x-watch": "content_model",
					"x-enum-provider": "editorByContentModel"
				},
				"content": {
					"type": "string",
					"x-watch": "editor",
					"x-compact": true,
					"title": "{{int:jsonforms-formschema-content}}",
					"x-title-format": "wikitext",
					"links": [
						{
							"rel": "describedBy",
							"href": "#/definitions/editor_{{editor}}"
						}
					]
				},
				"categories": {
					"type": "array",
					"title": "{{int:jsonforms-formschema-categories}}",
					"x-title-format": "wikitext",
					"items": {
						"type": "string",
						"x-input": "categorymultiselect"
					}
				}
			},
			"required": ["title"]
		},
		"newSchema": {
			"type": "object",
			"x-watch": "schema",
			"title": "{{int:jsonforms-formschema-edit-schema}}",
			"x-title-format": "wikitext",
			"properties": {
				"schema": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-json-schema}}",
					"x-title-format": "wikitext",
					"description": "{{int:jsonforms-formschema-json-schema-desc}}",
					"x-description-format": "wikitext",
					"default": "",
					"x-format": "text",
					"x-input": "OO.ui.DropdownInputWidget",
					"x-enum-provider": "jsonSchemas"
				},
				"preview": {
					"x-css-class": "jsonforms-editschema-preview",
					"x-compact": "true",
					"x-watch": "schema",
					"links": [
						{
							"rel": "describedBy",
							"href": "JsonSchema:{{schema}}",
							"x-destroy-values-on-switch": true,
							"x-no-validate": true
						}
					]
				}
			}
		}
	},
	"properties": {
		"form": {
			"x-no-title": true,
			"description": "{{int:jsonforms-formschema-form-combined-desc}}",
			"x-description-format": "wikitext",
			"x-layout": "tabs",
			"properties": {
				"main": {
					"title": "{{int:jsonforms-formschema-main}}",
					"x-title-format": "wikitext",
					"x-compact": true,
					"$ref": "#/definitions/article"
				},
				"schema": {
					"type": "object",
					"x-compact": true,
					"title": "{{int:jsonforms-formschema-schema}}",
					"x-title-format": "wikitext",
					"properties": {
						"schemaName": {
							"type": "string",
							"title": "{{int:jsonforms-formschema-json-schema}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-json-schema-combined-desc}}",
							"x-description-format": "wikitext",
							"default": "",
							"minLength": 1,
							"x-enum-provider": "jsonSchemas"
						},
						"editor": {
							"title": "{{int:jsonforms-formschema-editor}}",
							"x-title-format": "wikitext",
							"x-dependency": {
								"path": "schemaName",
								"op": "!=",
								"value": ""
							},
							"x-watch": "schemaName",
							"x-message": {
								"x-label-template": "Using schema <a href=\"{{replace wgArticlePath '$1' 'JsonSchema:'}}{{schemaName}}\">JsonSchema:{{schemaName}}</a>"
							},
							"links": [
								{
									"rel": "describedBy",
									"href": "JsonSchema:{{schemaName}}",
									"x-destroy-values-on-switch": true
								}
							]
						}
					}
				},
				"options": {
					"x-compact": true,
					"title": "{{int:jsonforms-formschema-options}}",
					"x-title-format": "wikitext",
					"properties": {
						"show_infobox": {
							"type": "boolean",
							"title": "{{int:jsonforms-formschema-show-infobox}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-show-infobox-desc}}",
							"x-description-format": "wikitext",
							"default": true
						},
						"infobox_position": {
							"type": "string",
							"title": "{{int:jsonforms-formschema-infobox-position}}",
							"x-title-format": "wikitext",
							"enum": ["right", "left", "top", "bottom"],
							"x-enum-titles": [
								"{{int:jsonforms-formschema-infobox-position-right}}",
								"{{int:jsonforms-formschema-infobox-position-left}}",
								"{{int:jsonforms-formschema-infobox-position-top}}",
								"{{int:jsonforms-formschema-infobox-position-bottom}}"
							],
							"x-enum-titles-format": "wikitext",
							"default": "right",
							"x-dependency": {
								"path": "show_infobox",
								"op": "==",
								"value": true
							}
						},
						"infobox_template": {
							"type": "string",
							"title": "{{int:jsonforms-formschema-infobox-template}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-infobox-template-desc}}",
							"x-description-format": "wikitext",
							"default": "",
							"x-input": "mw.widgets.TitleInputWidget",
							"x-input-config": {
								"namespace": 10
							},
							"x-dependency": {
								"path": "show_infobox",
								"op": "==",
								"value": true
							}
						},
						"template_print_scalar": {
							"type": "boolean",
							"title": "{{int:jsonforms-formschema-print-scalar}}",
							"x-title-format": "wikitext",
							"description": "{{int:jsonforms-formschema-print-scalar-desc}}",
							"x-description-format": "wikitext",
							"default": false,
							"x-dependency": {
								"path": "infobox_template",
								"op": "!=",
								"value": ""
							}
						}
					}
				}
			}
		},
		"footer": {
			"x-compact": true,
			"x-css-class": "jsonforms-outerform-footer",
			"x-default-properties": ["summary","minor", "buttons"],
			"properties": {
				"summary": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-summary}}",
					"x-title-format": "wikitext"
				},
				"minor": {
					"type": "boolean",
					"x-no-title": true,
					"description": "{{int:jsonforms-formschema-minor-edit}}",
					"x-description-format": "wikitext",
					"x-input": "checkbox",
					"x-control-config": {
						"align": "inline"
					}
				},
				"buttons": {
					"type": "object",
					"x-layout": "horizontal",
					"x-compact": true,
					"properties": {
						"submit": {
							"type": "null",
							"title": "{{int:jsonforms-formschema-save-changes}}",
							"x-title-format": "wikitext",
							"x-format": "button",
							"x-button-action": "submitButton",
							"x-input-config": {
								"flags": ["primary", "progressive"]
							}
						}
					}
				}
			}
		}
	}
}

