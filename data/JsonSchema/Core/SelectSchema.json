{
	"type": "object",
	"$id": "https://wikisphere.org/wiki/JsonSchema:Core/SelectSchema",
	"x-watch" : "schema",
	"title": "{{int:jsonforms-formschema-edit-schema}}",
	"x-title-format": "wikitext",
	"x-collapsible": true,
	"properties": {
		"schema": {
			"type": "string",
			"title": "{{int:jsonforms-formschema-json-schema}}",
			"x-title-format": "wikitext",
			"description": "{{int:jsonforms-formschema-json-schema-combined-desc}}",			
			"x-description-format": "wikitext",
			"default": "",
			"minLength": 1,
			"x-format": "autocomplete",
			"x-input": "LookupElement",
			"x-autocomplete-provider": "jsonSchemas"
		},
		"editor": {
			"x-compact": "true",
			"x-watch" : "schema",
			"links": [
				{
					"rel": "describedBy",
					"href": "JsonSchema:{{schema}}",
					"x-destroy-values-on-switch": true
				}
			]
		}
	}
}

