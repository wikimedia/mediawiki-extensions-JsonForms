{
	"type": "object",
	"$id": "https://wikisphere.org/wiki/JsonSchema:Core/SimpleFormUI",
	"x-compact": true,
	"x-css-class": "jsonforms-outerform",
	"x-default-properties": ["editor", "footer"],
	"required": [],
	"properties": {
		"editor": {
			"type": "string",
			"x-format": "json",
			"x-compact": true,
			"x-input": "jsonforms",
			"x-input-config": {
				"schema": ""
			}
		},
		"footer": {
			"x-compact": true,
			"x-css-class": "jsonforms-outerform-footer",
			"x-default-properties": ["summary", "minor", "buttons"],
			"properties": {
				"summary": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-summary}}",
					"x-title-format": "wikitext"
				},
				"minor": {
					"type": "boolean",
					"x-no-title": true,
					"description": "{{int:jsonforms-formschema-minor-edit}}",
					"x-description-format": "wikitext",
					"x-input": "checkbox",
					"x-control-config": {
						"align": "inline"
					}
				},
				"buttons": {
					"type": "object",
					"x-layout": "horizontal",
					"x-compact": true,
					"properties": {
						"submit": {
							"type": "null",
							"title": "{{int:jsonforms-formschema-save-changes}}",
							"x-title-format": "wikitext",
							"x-format": "button",
							"x-button-action": "submitButton",
							"x-input-config": {
								"flags": ["primary", "progressive"]
							}
						},
						"cancel": {
							"type": "null",
							"title": "{{int:jsonforms-formschema-cancel}}",
							"x-title-format": "wikitext",
							"x-format": "button",
							"x-button-action": "cancelButton",
							"x-input-config": {
								"flags": ["destructive"]
							}
						}
					}
				}
			}
		}
	}
}

