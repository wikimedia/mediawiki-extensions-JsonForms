{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://wikisphere.org/wiki/JsonSchema:Core/SlotManager",
	"type": "object",
	"x-layout": "tabs",
	"x-layout-config": {
		"mainLabel": "main"
	},
	"x-default-properties": ["content_model", "editor", "content", "categories"],
	"definitions": {
		"editor_wikieditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "wikitext",
			"x-input": "wikieditor"
		},
		"editor_codeeditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "codeeditor"
		},
		"editor_visualeditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "wikitext",
			"x-input": "visualeditor"
		},
		"editor_jsoneditor": {
			"type": "string",
			"x-compact": true,
			"x-format": "json",
			"x-input": "jsoneditor"
		},
		"editor_jsonforms": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input": "jsonforms",
			"x-input-config": {
				"schema": "JsonSchema:Core/SelectSchema"
			}
		},
		"editor_source": {
			"type": "string",
			"x-compact": true,
			"x-format": "textarea",
			"x-input-config": {
				"autosize": true,
				"rows": 6
			}
		},
		"editor_suneditor": {
			"x-compact": true,
			"type": "object",
			"title": "content",
			"type": "string",
			"x-compact": true,
			"x-format": "html",
			"x-input": "SunEditor"
		},
		"editor_easymde": {
			"type": "string",
			"x-compact": true,
			"x-format": "markdown",
			"x-input": "EasyMDE"
		},
		"slotOptions": {
			"type": "object",
			"x-compact": true,
			"x-rename": false,
			"required": ["content_model"],
			"x-default-properties": ["content_model", "editor", "content"],
			"properties": {
				"role": {
					"type": "string",
					"x-format": "hidden",
					"default": "main"
				},
				"content_model": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-content-model}}",
					"x-title-format": "wikitext",
					"default": "wikitext",
					"x-watch": "role",
					"x-enum-provider": "contentModelByRole"
				},
				"editor": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-editor}}",
					"x-title-format": "wikitext",
					"default": "source",
					"x-watch": "content_model",
					"x-enum-provider": "editorByContentModel"
				},
				"content": {
					"type": "string",
					"x-compact": true,
					"title": "{{int:jsonforms-formschema-content}}",
					"x-title-format": "wikitext",
					"x-watch": "editor",
					"links": [
						{
							"rel": "describedBy",
							"href": "#/definitions/editor_{{editor}}"
						}
					]
				}
			}
		},
		"newSlot": {
			"title": "{{int:jsonforms-formschema-new-slot}}",
			"x-title-format": "wikitext",
			"x-value-converter": "newSlot",
			"type": "object",
			"required": ["name"],
			"properties": {
				"name": {
					"title": "{{int:jsonforms-formschema-slot-name}}",
					"x-title-format": "wikitext",
					"type": "string",
					"x-enum-provider": "slotRolesNoMain"
				}
			}
		}
	},
	"allOf": [
		{
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"title": "{{int:jsonforms-formschema-title}}",
					"x-title-format": "wikitext",
					"minLength": 1,
					"x-input": "title",
					"x-create-only": true
				}
			},
			"required": ["title"]
		},
		{
			"$ref": "#/definitions/slotOptions"
		},
		{
			"type": "object",
			"properties": {
				"categories": {
					"type": "array",
					"title": "{{int:jsonforms-formschema-categories}}",
					"x-title-format": "wikitext",
					"items": {
						"type": "string",
						"x-input": "categorymultiselect"
					}
				}
			}
		}
	],
	"x-additional-properties-ui": [
		{
			"label": "{{int:jsonforms-formschema-new-slot}}",
			"x-label-format": "wikitext",
			"schema": "#/definitions/newSlot",
			"popup_size": "medium"
		}
	],
	"patternProperties": {
		"^[a-zA-Z0-9_-]+$": {
			"allOf": [
				{
					"$ref": "#/definitions/slotOptions"
				}
			]
		}
	}
}
